<clickhouse>
    <!-- Upstream users.d/enable_time_type.xml and users.d/distributed_insert_queue.xml:
         the migration chain needs the Time type, and the Distributed settings
         match every upstream install. -->
    <profiles>
        <default>
            <enable_time_time64_type>1</enable_time_time64_type>
            <prefer_localhost_replica>0</prefer_localhost_replica>
            <distributed_background_insert_batch>1</distributed_background_insert_batch>
            <distributed_background_insert_split_batch_on_failure>1</distributed_background_insert_split_batch_on_failure>
        </default>
    </profiles>
</clickhouse>
